# This file sets environment variables visible within the devcontainer.
# It mirrors the baseline template shape while keeping this repo's defaults
# suitable for local switcher development.

USER_DATA_SUBDIRECTORY=/

# Explicitly mark this as a G-Cubed devcontainer so the Python side updates uv
# before creating uv-managed venv_gcubed_* environments.
GCUBED_DEVCONTAINER=1

# Auto enable Rich's traceback handler.
RICH_TRACEBACKS=1

# Ensure uv copies dependencies into generated venvs instead of linking from a
# cache that can disappear when the container is rebuilt.
UV_LINK_MODE=copy

# Settings for G-Cubed Code prerequisites.
GCUBED_CODE_PACKAGE_NAME=gcubed
GCUBED_PYTHON_PREREQUISITES_REPO=https://github.com/McKibbin-Software-Group/python-gcubed-prerequisites
GCUBED_VENV_NAME_PREFIX=venv_gcubed_

# Shared rendezvous point for the Python client and VS Code extension server.
GCUBED_VENV_SOCKET_PATH=/tmp/gcubed_venv_switcher.sock

# ONLY set this for testing/troubleshooting or if working on G-Cubed Code source.

# NOTE: disables the PYTHON auto-switching when this env variable is _present_.
#       Any value will do.
#       EVEN setting it FALSE will disable the auto-switch function.
#       So just comment/uncomment the line!

# NOTE: can also be manually exported/unset in devcontainer terminal, which is
#       probably better for your mental health anyways...

#       you have been warned...

# GCUBED_CODE_AUTO_BUILD_SWITCHER_DISABLED=TRUE
